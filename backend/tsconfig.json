{
  "compilerOptions": {
    "target": "ES2020", 
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "node",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./**/*", "./types/**/*.d.ts"],
  "exclude": ["dist"]
}
