{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "server.ts",
    "routes/**/*.ts",
    "db/**/*.ts",
    "middlewares/**/*.ts",
    "models/**/*.ts"
  ]
}
